# OpenAI API key — if set, uses GPT-4o-mini for generation
# If not set, falls back to Ollama (llama3 must be running locally)
OPENAI_API_KEY=

# Optional: Override Ollama endpoint and model
# OLLAMA_URL=http://host.docker.internal:11434
# OLLAMA_MODEL=llama3

# Set to "true" to auto-run evaluation suite on first startup
# RUN_EVAL_ON_STARTUP=false

# ── Host ports (change these if you get "port already allocated" errors) ──────
MLFLOW_PORT=5001
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
POSTGRES_PORT=5432
TRAEFIK_DASHBOARD_PORT=8888
