# OpenAI API key — if set, uses GPT-4o-mini for generation
# If not set, falls back to Ollama (llama3 must be running locally)
OPENAI_API_KEY=

# Optional: Override Ollama endpoint and model
# OLLAMA_URL=http://host.docker.internal:11434
# OLLAMA_MODEL=llama3

# Evaluation judge: any OpenAI-compatible endpoint. Defaults to local Ollama (free).
# Run `ollama pull qwen2.5:7b` first.
# JUDGE_MODEL=qwen2.5:7b
# JUDGE_BASE_URL=            # empty -> {OLLAMA_URL}/v1
# JUDGE_API_KEY=             # only for hosted endpoints
# JUDGE_CONCURRENCY=2

# Set to "true" to auto-run evaluation suite on first startup
# RUN_EVAL_ON_STARTUP=false
